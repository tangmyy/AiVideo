QWidget { font-family: "Microsoft YaHei"; font-size: 13px; color: #f0f1f5; }
QWidget#root, QScrollArea#scroll { background: #101217; border: none; }
QLabel#brand { color: #bba2ee; font-size: 16px; font-weight: 700; }
QLabel#heading { color: #f7f7fa; font-size: 27px; font-weight: 700; }
QLabel#subtitle { color: #aeb4c1; font-size: 13px; }
QFrame#group { background: #1b1e26; border: 1px solid #303540; border-radius: 14px; }
QLabel#section { color: #e5e7ed; font-size: 14px; font-weight: 700; }
QLabel#videoTitle { color: #f7f7fa; font-size: 18px; font-weight: 700; }
QLabel#platform { color: #bba2ee; font-size: 12px; font-weight: 700; }
QLabel#cover { background: #14171e; border: 1px solid #424957; border-radius: 10px; color: #9da5b3; }
QLabel#status { color: #aeb4c1; font-size: 12px; }
QLineEdit, QComboBox, QPlainTextEdit { background: #14171e; color: #f0f1f5; border: 1px solid #4a515f; border-radius: 9px; padding: 9px 12px; selection-background-color: #69539c; }
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border: 1px solid #ad93e8; }
QLineEdit:disabled, QComboBox:disabled, QPlainTextEdit:disabled { color: #8a919e; border-color: #3a404b; }
QComboBox::drop-down { border: none; width: 36px; }
QComboBox QAbstractItemView { background: #211a2d; color: #f0f1f5; selection-background-color: #65458d; padding: 5px; }
QPushButton { background: #2a2f39; color: #f0f1f5; border: 1px solid #4d5563; border-radius: 9px; padding: 9px 18px; font-weight: 700; }
QPushButton:hover { background: #373e4b; border-color: #8f7cc0; }
QPushButton:pressed { background: #242a34; }
QPushButton:focus { border: 1px solid #c8b5ef; }
QPushButton#primary { background: #a98bea; color: #1d142a; border-color: #a98bea; }
QPushButton#primary:hover { background: #b99cf3; border-color: #b99cf3; }
QPushButton#modeButton { background: #14171e; color: #aeb4c1; border-color: #4a515f; }
QPushButton#modeButton:checked { background: #393347; border-color: #9b84d5; color: #ffffff; }
QPushButton:disabled, QPushButton#primary:disabled { background: #2b3038; color: #8a919e; border-color: #3a404b; }
QCheckBox { color: #e5e7ed; spacing: 9px; padding: 4px 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #7b8494; border-radius: 4px; background: #14171e; }
QCheckBox::indicator:checked { background: #a98bea; border-color: #a98bea; }
QCheckBox:focus { color: #ffffff; }
QProgressBar { background: #303642; color: #ffffff; border: none; border-radius: 6px; text-align: center; min-height: 13px; font-size: 10px; }
QProgressBar::chunk { background: #a98bea; border-radius: 6px; }
