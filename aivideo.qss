QWidget { font-family: "Microsoft YaHei"; font-size: 13px; }
QWidget#root { background: #17131c; color: #f5f1f8; }
QScrollArea#scroll { background: #17131c; border: none; }
QLabel#brand { color: #c6afff; font-size: 15px; font-weight: 700; }
QLabel#heading { color: #faf7fc; font-size: 24px; font-weight: 700; }
QLabel#subtitle { color: #b8adbf; font-size: 13px; }
QFrame#group { background: transparent; border: none; }
QLabel#section { color: #e1d8e8; font-size: 14px; font-weight: 700; }
QLabel#videoTitle { color: #faf7fc; font-size: 18px; font-weight: 700; }
QLabel#platform { color: #c6afff; font-size: 12px; font-weight: 700; }
QLabel#cover { background: #1b1621; border: 1px solid #43374d; border-radius: 8px; color: #a99ab2; }
QLabel#batchCover { background: #1b1621; color: #a99ab2; border-radius: 5px; }
QLabel#batchTitle { color: #faf7fc; font-size: 13px; font-weight: 700; }
QLabel#status { color: #c4b8cb; font-size: 12px; }
QLineEdit, QComboBox { background: #241e2b; color: #f5f1f8; border: 1px solid #584c62; border-radius: 7px; padding: 10px 12px; min-height: 24px; selection-background-color: #7657a9; }
QPlainTextEdit { background: #241e2b; color: #f5f1f8; border: 1px solid #584c62; border-radius: 7px; padding: 10px 12px; selection-background-color: #7657a9; }
QPlainTextEdit:focus { border-color: #c6afff; }
QPlainTextEdit:disabled { color: #8e8097; border-color: #3c3245; }
QListWidget#batchResults { background: #1b1621; color: #f5f1f8; border: 1px solid #43374d; border-radius: 7px; }
QListWidget#batchResults::item { background: #241e2b; border-bottom: 1px solid #3c3245; }
QLineEdit:focus, QComboBox:focus { border-color: #c6afff; }
QLineEdit:disabled, QComboBox:disabled { color: #8e8097; border-color: #3c3245; }
QComboBox::drop-down { border: none; width: 36px; }
QComboBox QAbstractItemView { background: #241e2b; color: #f5f1f8; selection-background-color: #614981; padding: 5px; }
QPushButton { background: #352c3e; color: #eee7f3; border: 1px solid #53465e; border-radius: 7px; padding: 10px 18px; min-height: 24px; font-weight: 700; }
QPushButton:hover { background: #463752; }
QPushButton:pressed { background: #2c2235; }
QPushButton#primary { background: #c6afff; color: #261934; border-color: #c6afff; }
QPushButton#primary:hover { background: #d8c8ff; border-color: #d8c8ff; }
QPushButton#modeButton { background: transparent; border: 1px solid #584c62; color: #c4b8cb; }
QPushButton#modeButton:checked { background: #463752; border-color: #c6afff; color: #faf7fc; }
QPushButton:disabled, QPushButton#primary:disabled { background: #342b3b; color: #8f8298; border-color: #342b3b; }
QCheckBox { color: #eee7f3; spacing: 8px; min-height: 36px; padding: 4px 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #877394; border-radius: 4px; background: #1a1521; }
QCheckBox::indicator:checked { background: #c6afff; border-color: #c6afff; }
QProgressBar { background: #372d40; color: #f5f1f8; border: none; border-radius: 6px; text-align: center; min-height: 13px; font-size: 10px; }
QProgressBar::chunk { background: #c6afff; border-radius: 6px; }
